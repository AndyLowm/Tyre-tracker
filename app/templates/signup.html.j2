{% extends "base.html.j2" %}
{% block title %}Create account · Tyre Tracker{% endblock %}
{% block body %}
    <div class="min-h-screen flex items-center justify-center px-4 py-10 bg-gradient-to-br from-stone-50 via-white to-sky-50">
        <div class="w-full max-w-sm">
            <div class="mb-8 text-center">
                <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-electric-500 text-white shadow-lg shadow-electric-500/30">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/>
                    </svg>
                </div>
                <h1 class="text-2xl font-semibold tracking-tight text-slate-900">Create your account</h1>
                <p class="mt-1 text-sm text-slate-500">Start tracking your tyre stock</p>
            </div>

            <form method="post" action="/signup" class="rounded-2xl bg-white/80 p-6 shadow-xl shadow-slate-200/60 ring-1 ring-slate-200 backdrop-blur sm:p-8">
                {% if error %}
                <div role="alert" class="mb-5 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700 ring-1 ring-red-200">
                    {{ error }}
                </div>
                {% endif %}

                <div class="space-y-5">
                    <div>
                        <label for="username" class="block text-sm font-medium text-slate-700">Username</label>
                        <input id="username" name="username" type="text" required autofocus
                               minlength="4" maxlength="24"
                               autocomplete="username" value="{{ username or '' }}"
                               class="mt-1.5 block w-full rounded-lg border-0 bg-white px-3.5 py-2.5 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-electric-500">
                        <p class="mt-1 text-xs text-slate-500">4-24 characters</p>
                    </div>
                    <div>
                        <label for="password" class="block text-sm font-medium text-slate-700">Password</label>
                        <input id="password" name="password" type="password" required
                               minlength="8" maxlength="128"
                               autocomplete="new-password"
                               class="mt-1.5 block w-full rounded-lg border-0 bg-white px-3.5 py-2.5 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-electric-500">
                        <p class="mt-1 text-xs text-slate-500">At least 8 characters</p>
                    </div>
                    <div>
                        <label for="confirm_password" class="block text-sm font-medium text-slate-700">Confirm password</label>
                        <input id="confirm_password" name="confirm_password" type="password" required
                               minlength="8" maxlength="128"
                               autocomplete="new-password"
                               class="mt-1.5 block w-full rounded-lg border-0 bg-white px-3.5 py-2.5 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-electric-500">
                    </div>
                </div>

                <button type="submit"
                        class="mt-6 w-full rounded-lg bg-electric-500 px-4 py-2.5 text-sm font-semibold text-white shadow-lg shadow-electric-500/30 transition hover:bg-electric-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-electric-400 focus-visible:ring-offset-2 active:scale-[0.99]">
                    Create account
                </button>
            </form>

            <p class="mt-6 text-center text-sm text-slate-500">
                Already have an account?
                <a href="/login" class="font-semibold text-electric-500 hover:text-electric-600">Sign in</a>
            </p>
        </div>
    </div>
{% endblock %}
